<UserControl x:Class="AIO_Aicrag.Dialog.ModernDialog"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             HorizontalAlignment="Stretch"
             VerticalAlignment="Stretch">

    <UserControl.Resources>

        <!-- ========================================================= -->
        <!-- COLORES -->
        <!-- ========================================================= -->

        <SolidColorBrush x:Key="DialogBackground"
                         Color="#FFFFFF"/>

        <SolidColorBrush x:Key="DialogBorder"
                         Color="#E2E7F0"/>

        <SolidColorBrush x:Key="DialogText"
                         Color="#172033"/>

        <SolidColorBrush x:Key="DialogSecondary"
                         Color="#667085"/>

        <SolidColorBrush x:Key="DialogOverlay"
                         Color="#99000000"/>

        <SolidColorBrush x:Key="Primary"
                         Color="#2563EB"/>

        <SolidColorBrush x:Key="PrimaryHover"
                         Color="#1D4ED8"/>

        <SolidColorBrush x:Key="Danger"
                         Color="#DC2626"/>

        <SolidColorBrush x:Key="DangerHover"
                         Color="#B91C1C"/>


        <!-- ========================================================= -->
        <!-- BOTÓN SECUNDARIO -->
        <!-- ========================================================= -->

        <Style x:Key="DialogSecondaryButton"
               TargetType="{x:Type Button}">

            <Setter Property="Height"
                    Value="42"/>

            <Setter Property="MinWidth"
                    Value="105"/>

            <Setter Property="Padding"
                    Value="18,0"/>

            <Setter Property="Margin"
                    Value="5,0"/>

            <Setter Property="Background"
                    Value="#F1F4F9"/>

            <Setter Property="Foreground"
                    Value="#172033"/>

            <Setter Property="BorderBrush"
                    Value="#E2E7F0"/>

            <Setter Property="BorderThickness"
                    Value="1"/>

            <Setter Property="FontSize"
                    Value="12"/>

            <Setter Property="FontWeight"
                    Value="SemiBold"/>

            <Setter Property="Cursor"
                    Value="Hand"/>

            <Setter Property="Template">

                <Setter.Value>

                    <ControlTemplate TargetType="{x:Type Button}">

                        <Border x:Name="Border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8">

                            <ContentPresenter
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"/>

                        </Border>

                        <ControlTemplate.Triggers>

                            <Trigger Property="IsMouseOver"
                                     Value="True">

                                <Setter TargetName="Border"
                                        Property="Background"
                                        Value="#E8EEF9"/>

                            </Trigger>

                            <Trigger Property="IsPressed"
                                     Value="True">

                                <Setter TargetName="Border"
                                        Property="Opacity"
                                        Value="0.8"/>

                            </Trigger>

                        </ControlTemplate.Triggers>

                    </ControlTemplate>

                </Setter.Value>

            </Setter>

        </Style>


        <!-- ========================================================= -->
        <!-- BOTÓN PRINCIPAL -->
        <!-- ========================================================= -->

        <Style x:Key="DialogPrimaryButton"
               TargetType="{x:Type Button}">

            <Setter Property="Height"
                    Value="42"/>

            <Setter Property="MinWidth"
                    Value="120"/>

            <Setter Property="Padding"
                    Value="18,0"/>

            <Setter Property="Margin"
                    Value="5,0"/>

            <Setter Property="Background"
                    Value="{StaticResource Primary}"/>

            <Setter Property="Foreground"
                    Value="White"/>

            <Setter Property="BorderThickness"
                    Value="0"/>

            <Setter Property="FontSize"
                    Value="12"/>

            <Setter Property="FontWeight"
                    Value="Bold"/>

            <Setter Property="Cursor"
                    Value="Hand"/>

            <Setter Property="Template">

                <Setter.Value>

                    <ControlTemplate TargetType="{x:Type Button}">

                        <Border x:Name="Border"
                                Background="{TemplateBinding Background}"
                                CornerRadius="8">

                            <ContentPresenter
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"/>

                        </Border>

                        <ControlTemplate.Triggers>

                            <Trigger Property="IsMouseOver"
                                     Value="True">

                                <Setter TargetName="Border"
                                        Property="Background"
                                        Value="{StaticResource PrimaryHover}"/>

                            </Trigger>

                            <Trigger Property="IsPressed"
                                     Value="True">

                                <Setter TargetName="Border"
                                        Property="Opacity"
                                        Value="0.8"/>

                            </Trigger>

                        </ControlTemplate.Triggers>

                    </ControlTemplate>

                </Setter.Value>

            </Setter>

        </Style>


        <!-- ========================================================= -->
        <!-- BOTÓN ROJO -->
        <!-- ========================================================= -->

        <Style x:Key="DialogDangerButton"
               TargetType="{x:Type Button}"
               BasedOn="{StaticResource DialogPrimaryButton}">

            <Setter Property="Background"
                    Value="{StaticResource Danger}"/>

            <Setter Property="Template">

                <Setter.Value>

                    <ControlTemplate TargetType="{x:Type Button}">

                        <Border x:Name="Border"
                                Background="{TemplateBinding Background}"
                                CornerRadius="8">

                            <ContentPresenter
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"/>

                        </Border>

                        <ControlTemplate.Triggers>

                            <Trigger Property="IsMouseOver"
                                     Value="True">

                                <Setter TargetName="Border"
                                        Property="Background"
                                        Value="{StaticResource DangerHover}"/>

                            </Trigger>

                            <Trigger Property="IsPressed"
                                     Value="True">

                                <Setter TargetName="Border"
                                        Property="Opacity"
                                        Value="0.8"/>

                            </Trigger>

                        </ControlTemplate.Triggers>

                    </ControlTemplate>

                </Setter.Value>

            </Setter>

        </Style>

    </UserControl.Resources>


    <!-- ============================================================= -->
    <!-- OVERLAY -->
    <!-- ============================================================= -->

    <Grid Background="{StaticResource DialogOverlay}">

        <!-- ========================================================= -->
        <!-- TARJETA -->
        <!-- ========================================================= -->

        <Border Width="460"
                MaxWidth="460"
                Background="{StaticResource DialogBackground}"
                BorderBrush="{StaticResource DialogBorder}"
                BorderThickness="1"
                CornerRadius="18"
                Padding="24"
                HorizontalAlignment="Center"
                VerticalAlignment="Center">

            <Grid>

                <Grid.RowDefinitions>

                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>

                </Grid.RowDefinitions>


                <!-- ================================================= -->
                <!-- ICONO -->
                <!-- ================================================= -->

                <Border Grid.Row="0"
                        x:Name="IconContainer"
                        Width="58"
                        Height="58"
                        CornerRadius="29"
                        HorizontalAlignment="Center"
                        Margin="0,0,0,16">

                    <TextBlock x:Name="TxtIcon"
                               Text="!"
                               FontSize="28"
                               FontWeight="Bold"
                               Foreground="White"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"/>

                </Border>


                <!-- ================================================= -->
                <!-- TITULO -->
                <!-- ================================================= -->

                <TextBlock Grid.Row="1"
                           x:Name="TxtTitle"
                           Text="Título"
                           Foreground="{StaticResource DialogText}"
                           FontSize="20"
                           FontWeight="Bold"
                           HorizontalAlignment="Center"
                           TextAlignment="Center"
                           TextWrapping="Wrap"
                           Margin="0,0,0,10"/>


                <!-- ================================================= -->
                <!-- MENSAJE -->
                <!-- ================================================= -->

                <TextBlock Grid.Row="2"
                           x:Name="TxtMessage"
                           Text="Mensaje"
                           Foreground="{StaticResource DialogSecondary}"
                           FontSize="13"
                           LineHeight="20"
                           TextWrapping="Wrap"
                           TextAlignment="Center"
                           HorizontalAlignment="Center"
                           Margin="10,0,10,24"/>


                <!-- ================================================= -->
                <!-- BOTONES -->
                <!-- ================================================= -->

                <StackPanel Grid.Row="3"
                            x:Name="ButtonsPanel"
                            Orientation="Horizontal"
                            HorizontalAlignment="Center">

                    <Button x:Name="BtnSecondary"
                            Content="Cancelar"
                            Click="BtnSecondary_Click"
                            Style="{StaticResource DialogSecondaryButton}"/>

                    <Button x:Name="BtnPrimary"
                            Content="Aceptar"
                            Click="BtnPrimary_Click"
                            Style="{StaticResource DialogPrimaryButton}"/>

                </StackPanel>

            </Grid>

        </Border>

    </Grid>

</UserControl>