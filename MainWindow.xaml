<Window x:Class="AIO_Aicrag.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="AIO Aicrag"
        Width="1440"
        Height="900"
        MinWidth="1180"
        MinHeight="720"
        WindowState="Maximized"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource BgWindow}">

    <Window.Resources>

        <!-- COLORS -->

        <SolidColorBrush x:Key="BgWindow" Color="#F5F7FB"/>
        <SolidColorBrush x:Key="BgSidebar" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="BgCard" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="BgItem" Color="#F1F4F9"/>
        <SolidColorBrush x:Key="BgHover" Color="#E8EEF9"/>

        <SolidColorBrush x:Key="TextPrimary" Color="#172033"/>
        <SolidColorBrush x:Key="TextSecondary" Color="#667085"/>
        <SolidColorBrush x:Key="TextMuted" Color="#98A2B3"/>

        <SolidColorBrush x:Key="BorderColor" Color="#E2E7F0"/>

        <SolidColorBrush x:Key="Accent" Color="#2563EB"/>
        <SolidColorBrush x:Key="AccentHover" Color="#1D4ED8"/>
        <SolidColorBrush x:Key="AccentLight" Color="#E8F0FF"/>

        <SolidColorBrush x:Key="AccentRed" Color="#DC2626"/>
        <SolidColorBrush x:Key="AccentRedHover" Color="#B91C1C"/>

        <SolidColorBrush x:Key="Success" Color="#16A34A"/>
        <SolidColorBrush x:Key="Warning" Color="#D97706"/>
        <SolidColorBrush x:Key="Danger" Color="#DC2626"/>

        <SolidColorBrush x:Key="ConsoleBg" Color="#101828"/>
        <SolidColorBrush x:Key="ConsoleText" Color="#7DD3FC"/>

        <!-- SHADOWS -->

        <DropShadowEffect x:Key="CardShadow"
                          BlurRadius="14"
                          ShadowDepth="1"
                          Opacity="0.04"/>

        <DropShadowEffect x:Key="SmallShadow"
                          BlurRadius="8"
                          ShadowDepth="1"
                          Opacity="0.03"/>

        <!-- BUTTON -->

        <Style x:Key="ModernButton"
               TargetType="Button">

            <Setter Property="Foreground"
                    Value="{DynamicResource TextPrimary}"/>

            <Setter Property="Background"
                    Value="{DynamicResource BgCard}"/>

            <Setter Property="BorderBrush"
                    Value="{DynamicResource BorderColor}"/>

            <Setter Property="BorderThickness"
                    Value="1"/>

            <Setter Property="Padding"
                    Value="12,8"/>

            <Setter Property="FontSize"
                    Value="13"/>

            <Setter Property="FontWeight"
                    Value="SemiBold"/>

            <Setter Property="Cursor"
                    Value="Hand"/>

            <Setter Property="HorizontalContentAlignment"
                    Value="Center"/>

            <Setter Property="VerticalContentAlignment"
                    Value="Center"/>

            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">

                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="7"
                                Padding="{TemplateBinding Padding}">

                            <ContentPresenter
                                Content="{TemplateBinding Content}"
                                ContentTemplate="{TemplateBinding ContentTemplate}"
                                HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>

                        </Border>

                        <ControlTemplate.Triggers>

                            <Trigger Property="IsMouseOver"
                                     Value="True">

                                <Setter TargetName="ButtonBorder"
                                        Property="Background"
                                        Value="{DynamicResource BgHover}"/>

                            </Trigger>

                            <Trigger Property="IsPressed"
                                     Value="True">

                                <Setter TargetName="ButtonBorder"
                                        Property="Opacity"
                                        Value="0.8"/>

                            </Trigger>

                            <Trigger Property="IsEnabled"
                                     Value="False">

                                <Setter TargetName="ButtonBorder"
                                        Property="Opacity"
                                        Value="0.45"/>

                            </Trigger>

                        </ControlTemplate.Triggers>

                    </ControlTemplate>
                </Setter.Value>
            </Setter>

        </Style>

        <!-- PRIMARY BUTTON -->

        <Style x:Key="PrimaryButton"
               TargetType="Button"
               BasedOn="{StaticResource ModernButton}">

            <Setter Property="Background"
                    Value="{DynamicResource Accent}"/>

            <Setter Property="Foreground"
                    Value="White"/>

            <Setter Property="BorderBrush"
                    Value="{DynamicResource Accent}"/>

            <Setter Property="Padding"
                    Value="17,10"/>

            <Setter Property="FontWeight"
                    Value="SemiBold"/>

            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">

                        <Border x:Name="PrimaryBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">

                            <ContentPresenter
                                Content="{TemplateBinding Content}"
                                ContentTemplate="{TemplateBinding ContentTemplate}"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"/>

                        </Border>

                        <ControlTemplate.Triggers>

                            <Trigger Property="IsMouseOver"
                                     Value="True">

                                <Setter TargetName="PrimaryBorder"
                                        Property="Background"
                                        Value="{DynamicResource AccentHover}"/>

                            </Trigger>

                            <Trigger Property="IsPressed"
                                     Value="True">

                                <Setter TargetName="PrimaryBorder"
                                        Property="Opacity"
                                        Value="0.85"/>

                            </Trigger>

                            <Trigger Property="IsEnabled"
                                     Value="False">

                                <Setter TargetName="PrimaryBorder"
                                        Property="Opacity"
                                        Value="0.45"/>

                            </Trigger>

                        </ControlTemplate.Triggers>

                    </ControlTemplate>
                </Setter.Value>
            </Setter>

        </Style>

        <!-- SIDEBAR BUTTON -->

        <Style x:Key="SidebarButton"
               TargetType="Button">

            <Setter Property="Background"
                    Value="Transparent"/>

            <Setter Property="Foreground"
                    Value="{DynamicResource TextSecondary}"/>

            <Setter Property="BorderThickness"
                    Value="0"/>

            <Setter Property="Padding"
                    Value="11,9"/>

            <Setter Property="Margin"
                    Value="0,1"/>

            <Setter Property="HorizontalContentAlignment"
                    Value="Left"/>

            <Setter Property="VerticalContentAlignment"
                    Value="Center"/>

            <Setter Property="Cursor"
                    Value="Hand"/>

            <Setter Property="FontSize"
                    Value="13"/>

            <Setter Property="FontWeight"
                    Value="SemiBold"/>

            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">

                        <Border x:Name="SidebarBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">

                            <ContentPresenter
                                Margin="3,0"
                                HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>

                        </Border>

                        <ControlTemplate.Triggers>

                            <Trigger Property="IsMouseOver"
                                     Value="True">

                                <Setter TargetName="SidebarBorder"
                                        Property="Background"
                                        Value="{DynamicResource BgHover}"/>

                                <Setter Property="Foreground"
                                        Value="{DynamicResource TextPrimary}"/>

                            </Trigger>

                        </ControlTemplate.Triggers>

                    </ControlTemplate>
                </Setter.Value>
            </Setter>

        </Style>

        <!-- CATEGORY -->

        <Style x:Key="CategoryButton"
               TargetType="Button">

            <Setter Property="Background"
                    Value="{DynamicResource BgCard}"/>

            <Setter Property="Foreground"
                    Value="{DynamicResource TextSecondary}"/>

            <Setter Property="BorderBrush"
                    Value="{DynamicResource BorderColor}"/>

            <Setter Property="BorderThickness"
                    Value="1"/>

            <Setter Property="Padding"
                    Value="12,7"/>

            <Setter Property="Margin"
                    Value="0,0,8,0"/>

            <Setter Property="FontSize"
                    Value="12.5"/>

            <Setter Property="FontWeight"
                    Value="SemiBold"/>

            <Setter Property="Cursor"
                    Value="Hand"/>

            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">

                        <Border x:Name="ChipBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="12"
                                Padding="{TemplateBinding Padding}">

                            <ContentPresenter
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"/>

                        </Border>

                        <ControlTemplate.Triggers>

                            <Trigger Property="IsMouseOver"
                                     Value="True">

                                <Setter TargetName="ChipBorder"
                                        Property="Background"
                                        Value="{DynamicResource BgHover}"/>

                                <Setter TargetName="ChipBorder"
                                        Property="BorderBrush"
                                        Value="{DynamicResource Accent}"/>

                            </Trigger>

                        </ControlTemplate.Triggers>

                    </ControlTemplate>
                </Setter.Value>
            </Setter>

        </Style>

        <!-- SEARCH -->

        <Style x:Key="SearchBox"
               TargetType="TextBox">

            <Setter Property="Background"
                    Value="{DynamicResource BgItem}"/>

            <Setter Property="Foreground"
                    Value="{DynamicResource TextPrimary}"/>

            <Setter Property="BorderBrush"
                    Value="{DynamicResource BorderColor}"/>

            <Setter Property="BorderThickness"
                    Value="1"/>

            <Setter Property="Padding"
                    Value="42,0,15,0"/>

            <Setter Property="FontSize"
                    Value="13"/>

            <Setter Property="VerticalContentAlignment"
                    Value="Center"/>

            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">

                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8">

                            <ScrollViewer x:Name="PART_ContentHost"
                                          Margin="{TemplateBinding Padding}"/>

                        </Border>

                    </ControlTemplate>
                </Setter.Value>
            </Setter>

        </Style>

        <!-- CHECKBOX -->

        <Style x:Key="ModernCheckBox"
               TargetType="CheckBox">

            <Setter Property="Cursor"
                    Value="Hand"/>

            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">

                        <Grid Width="24"
                              Height="24">

                            <Border x:Name="Box"
                                    Width="22"
                                    Height="22"
                                    CornerRadius="7"
                                    BorderThickness="2"
                                    BorderBrush="{DynamicResource BorderColor}"
                                    Background="{DynamicResource BgCard}"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"/>

                            <TextBlock x:Name="CheckMark"
                                       Text="✓"
                                       Foreground="White"
                                       FontWeight="Bold"
                                       FontSize="13"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       Visibility="Collapsed"/>

                        </Grid>

                        <ControlTemplate.Triggers>

                            <Trigger Property="IsChecked"
                                     Value="True">

                                <Setter TargetName="Box"
                                        Property="Background"
                                        Value="{DynamicResource Accent}"/>

                                <Setter TargetName="Box"
                                        Property="BorderBrush"
                                        Value="{DynamicResource Accent}"/>

                                <Setter TargetName="CheckMark"
                                        Property="Visibility"
                                        Value="Visible"/>

                            </Trigger>

                            <Trigger Property="IsMouseOver"
                                     Value="True">

                                <Setter TargetName="Box"
                                        Property="BorderBrush"
                                        Value="{DynamicResource Accent}"/>

                            </Trigger>

                        </ControlTemplate.Triggers>

                    </ControlTemplate>
                </Setter.Value>
            </Setter>

        </Style>

        <!-- CARD -->

        <Style x:Key="AppCard"
               TargetType="Border">

            <Setter Property="Background"
                    Value="{DynamicResource BgCard}"/>

            <Setter Property="BorderBrush"
                    Value="{DynamicResource BorderColor}"/>

            <Setter Property="BorderThickness"
                    Value="1"/>

            <Setter Property="CornerRadius"
                    Value="10"/>

            <Setter Property="Padding"
                    Value="16"/>

            <Setter Property="Margin"
                    Value="0,0,12,12"/>

            <Setter Property="Effect"
                    Value="{StaticResource SmallShadow}"/>

            <Style.Triggers>

                <DataTrigger Binding="{Binding IsSelected}"
                             Value="True">

                    <Setter Property="Background"
                            Value="{DynamicResource AccentLight}"/>

                    <Setter Property="BorderBrush"
                            Value="{DynamicResource Accent}"/>

                </DataTrigger>

            </Style.Triggers>

        </Style>

        <!-- SCROLLBAR -->

        <Style TargetType="ScrollBar">

            <Setter Property="Width"
                    Value="8"/>

            <Setter Property="Background"
                    Value="Transparent"/>

            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">

                        <Grid Background="Transparent">

                            <Track x:Name="PART_Track"
                                   IsDirectionReversed="True">

                                <Track.Thumb>
                                    <Thumb>

                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">

                                                <Border Background="{DynamicResource BorderColor}"
                                                        CornerRadius="4"
                                                        Margin="1"/>

                                            </ControlTemplate>
                                        </Thumb.Template>

                                    </Thumb>
                                </Track.Thumb>

                            </Track>

                        </Grid>

                    </ControlTemplate>
                </Setter.Value>
            </Setter>

        </Style>

    </Window.Resources>

    <!-- ROOT -->

    <Grid Background="{DynamicResource BgWindow}">

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="248"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- SIDEBAR -->

        <Border Grid.Column="0"
                Background="{DynamicResource BgSidebar}"
                BorderBrush="{DynamicResource BorderColor}"
                BorderThickness="0,0,1,0">

            <Grid Margin="18,22">

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- LOGO -->

                <StackPanel Grid.Row="0">

                    <StackPanel Orientation="Horizontal">

                        <Border Width="40"
                                Height="40"
                                CornerRadius="11"
                                Background="{DynamicResource Accent}">

                            <TextBlock Text="A"
                                       Foreground="White"
                                       FontSize="21"
                                       FontWeight="Bold"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>

                        </Border>

                        <StackPanel Margin="11,0,0,0"
                                    VerticalAlignment="Center">

                            <TextBlock Text="AICRAG"
                                       Foreground="{DynamicResource TextPrimary}"
                                       FontSize="17"
                                       FontWeight="Bold"/>

                            <TextBlock Text="WPI INSTALLER"
                                       Foreground="{DynamicResource TextMuted}"
                                       FontSize="9"
                                       FontWeight="SemiBold"/>

                        </StackPanel>

                    </StackPanel>

                </StackPanel>

                <!-- NAVIGATION -->

                <StackPanel Grid.Row="1"
                            Margin="0,40,0,0">

                    <TextBlock Text="WORKSPACE"
                               Foreground="{DynamicResource TextMuted}"
                               FontSize="10"
                               FontWeight="Bold"
                               Margin="13,0,0,10"/>

                    <Button x:Name="BtnHome"
                            Style="{StaticResource SidebarButton}"
                            Background="{DynamicResource AccentLight}"
                            Foreground="{DynamicResource Accent}"
                            Margin="0,1,0,5"
                            Click="BtnHome_Click">

                        <StackPanel Orientation="Horizontal">

                            <TextBlock Text="⌂"
                                       FontSize="17"
                                       Width="27"/>

                            <TextBlock Text="Inicio"
                                       VerticalAlignment="Center"/>

                        </StackPanel>

                    </Button>

                    <Button x:Name="BtnApplications"
                            Style="{StaticResource SidebarButton}"
                            Click="BtnApplications_Click">

                        <StackPanel Orientation="Horizontal">

                            <TextBlock Text="▦"
                                       FontSize="16"
                                       Width="27"/>

                            <TextBlock Text="Aplicaciones"
                                       VerticalAlignment="Center"/>

                        </StackPanel>

                    </Button>

                    <Button x:Name="BtnPresets"
                            Style="{StaticResource SidebarButton}"
                            Click="BtnPresets_Click">

                        <StackPanel Orientation="Horizontal">

                            <TextBlock Text="★"
                                       FontSize="15"
                                       Width="27"/>

                            <TextBlock Text="Presets"
                                       VerticalAlignment="Center"/>

                        </StackPanel>

                    </Button>

                    <Button x:Name="BtnHistory"
                            Style="{StaticResource SidebarButton}">

                        <StackPanel Orientation="Horizontal">

                            <TextBlock Text="◷"
                                       FontSize="16"
                                       Width="27"/>

                            <TextBlock Text="Historial"
                                       VerticalAlignment="Center"/>

                        </StackPanel>

                    </Button>

                    <Button x:Name="BtnSettings"
                            Style="{StaticResource SidebarButton}">

                        <StackPanel Orientation="Horizontal">

                            <TextBlock Text="⚙"
                                       FontSize="16"
                                       Width="27"/>

                            <TextBlock Text="Configuración"
                                       VerticalAlignment="Center"/>

                        </StackPanel>

                    </Button>

                </StackPanel>

                <!-- BOTTOM -->

                <StackPanel Grid.Row="3">

                    <Border Background="{DynamicResource BgItem}"
                            CornerRadius="10"
                            Padding="12"
                            Margin="0,0,0,12">

                        <StackPanel>

                            <TextBlock Text="ACCIONES RÁPIDAS"
                                       Foreground="{DynamicResource TextMuted}"
                                       FontSize="9"
                                       FontWeight="Bold"
                                       Margin="0,0,0,8"/>

                            <Button x:Name="BtnSelectAll"
                                    Content="Seleccionar todo"
                                    Style="{StaticResource ModernButton}"
                                    HorizontalContentAlignment="Left"
                                    Click="BtnSelectAll_Click"/>

                            <Button x:Name="BtnDeselectAll"
                                    Content="Limpiar selección"
                                    Style="{StaticResource ModernButton}"
                                    HorizontalContentAlignment="Left"
                                    Margin="0,6,0,0"
                                    Click="BtnDeselectAll_Click"/>

                        </StackPanel>

                    </Border>

                    <Button x:Name="BtnToggleTheme"
                            Style="{StaticResource SidebarButton}"
                            Click="BtnToggleTheme_Click">

                        <StackPanel Orientation="Horizontal">

                            <TextBlock Text="☾"
                                       FontSize="16"
                                       Width="27"/>

                            <TextBlock x:Name="TxtThemeButton"
                                       Text="Modo oscuro"
                                       VerticalAlignment="Center"/>

                        </StackPanel>

                    </Button>

                    <TextBlock Text="AIO Aicrag"
                               Foreground="{DynamicResource TextMuted}"
                               FontSize="10"
                               Margin="13,14,0,0"/>

                    <TextBlock Text="Windows Post-Install"
                               Foreground="{DynamicResource TextMuted}"
                               FontSize="9"
                               Margin="13,2,0,0"/>

                </StackPanel>

            </Grid>

        </Border>

        <!-- MAIN -->

        <Grid Grid.Column="1"
              Margin="34,28,34,24">

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- HEADER -->

            <Grid Grid.Row="0">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel>

                    <TextBlock Text="Preparando tu PC"
                               Foreground="{DynamicResource TextPrimary}"
                               FontSize="28"
                               FontWeight="Bold"/>

                    <TextBlock Text="Instala las aplicaciones que necesitas de forma rápida y sencilla."
                               Foreground="{DynamicResource TextSecondary}"
                               FontSize="13"
                               Margin="0,5,0,0"/>

                </StackPanel>

                <Border Grid.Column="1"
                        Background="{DynamicResource BgCard}"
                        BorderBrush="{DynamicResource BorderColor}"
                        BorderThickness="1"
                        CornerRadius="10"
                        Padding="14,10">

                    <StackPanel>

                        <TextBlock Text="EQUIPO"
                                   Foreground="{DynamicResource TextMuted}"
                                   FontSize="9"
                                   FontWeight="Bold"/>

                        <TextBlock x:Name="TxtInfoHardware"
                                   Text="Cargando información..."
                                   Foreground="{DynamicResource TextSecondary}"
                                   FontSize="11"
                                   Margin="0,3,0,0"/>

                    </StackPanel>

                </Border>

            </Grid>

            <!-- DASHBOARD -->

            <Grid Grid.Row="1"
                  Margin="0,24,0,22">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0"
                        Style="{StaticResource AppCard}"
                        Margin="0,0,10,0">

                    <Grid>

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel>

                            <TextBlock Text="APLICACIONES"
                                       Foreground="{DynamicResource TextMuted}"
                                       FontSize="9"
                                       FontWeight="Bold"/>

                            <TextBlock x:Name="TxtTotalApps"
                                       Text="0"
                                       Foreground="{DynamicResource TextPrimary}"
                                       FontSize="26"
                                       FontWeight="Bold"
                                       Margin="0,5,0,0"/>

                            <TextBlock Text="disponibles"
                                       Foreground="{DynamicResource TextSecondary}"
                                       FontSize="11"/>

                        </StackPanel>

                        <Border Grid.Column="1"
                                Width="42"
                                Height="42"
                                Background="{DynamicResource AccentLight}"
                                CornerRadius="10">

                            <TextBlock Text="▦"
                                       Foreground="{DynamicResource Accent}"
                                       FontSize="20"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>

                        </Border>

                    </Grid>

                </Border>

                <Border Grid.Column="1"
                        Style="{StaticResource AppCard}"
                        Margin="4,0,6,0">

                    <Grid>

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel>

                            <TextBlock Text="SELECCIONADAS"
                                       Foreground="{DynamicResource TextMuted}"
                                       FontSize="9"
                                       FontWeight="Bold"/>

                            <TextBlock x:Name="TxtSelectedApps"
                                       Text="0"
                                       Foreground="{DynamicResource TextPrimary}"
                                       FontSize="26"
                                       FontWeight="Bold"
                                       Margin="0,5,0,0"/>

                            <TextBlock Text="listas para instalar"
                                       Foreground="{DynamicResource TextSecondary}"
                                       FontSize="11"/>

                        </StackPanel>

                        <Border Grid.Column="1"
                                Width="42"
                                Height="42"
                                Background="#EAF8EF"
                                CornerRadius="10">

                            <TextBlock Text="✓"
                                       Foreground="{DynamicResource Success}"
                                       FontSize="20"
                                       FontWeight="Bold"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>

                        </Border>

                    </Grid>

                </Border>

                <Border Grid.Column="2"
                        Style="{StaticResource AppCard}"
                        Margin="6,0,4,0">

                    <Grid>

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel>

                            <TextBlock Text="PRESETS"
                                       Foreground="{DynamicResource TextMuted}"
                                       FontSize="9"
                                       FontWeight="Bold"/>

                            <TextBlock Text="3"
                                       Foreground="{DynamicResource TextPrimary}"
                                       FontSize="26"
                                       FontWeight="Bold"
                                       Margin="0,5,0,0"/>

                            <TextBlock Text="configuraciones"
                                       Foreground="{DynamicResource TextSecondary}"
                                       FontSize="11"/>

                        </StackPanel>

                        <Border Grid.Column="1"
                                Width="42"
                                Height="42"
                                Background="#FFF6E5"
                                CornerRadius="10">

                            <TextBlock Text="★"
                                       Foreground="{DynamicResource Warning}"
                                       FontSize="19"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>

                        </Border>

                    </Grid>

                </Border>

                <Border Grid.Column="3"
                        Style="{StaticResource AppCard}"
                        Margin="10,0,0,0">

                    <Grid>

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel>

                            <TextBlock Text="ESTADO"
                                       Foreground="{DynamicResource TextMuted}"
                                       FontSize="9"
                                       FontWeight="Bold"/>

                            <TextBlock x:Name="TxtSystemStatus"
                                       Text="Listo"
                                       Foreground="{DynamicResource Success}"
                                       FontSize="21"
                                       FontWeight="Bold"
                                       Margin="0,7,0,0"/>

                        </StackPanel>

                        <Border Grid.Column="1"
                                Width="42"
                                Height="42"
                                Background="#EAF8EF"
                                CornerRadius="10">

                            <Ellipse Width="10"
                                     Height="10"
                                     Fill="{DynamicResource Success}"
                                     HorizontalAlignment="Center"
                                     VerticalAlignment="Center"/>

                        </Border>

                    </Grid>

                </Border>

            </Grid>

            <!-- CONTENT -->

            <Grid Grid.Row="2">

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- SEARCH -->

                <Grid Grid.Row="0">

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Grid>

                        <TextBox x:Name="TxtSearch"
                                 Height="42"
                                 Style="{StaticResource SearchBox}"
                                 TextChanged="TxtSearch_TextChanged"/>

                        <TextBlock Text="⌕"
                                   Foreground="{DynamicResource TextMuted}"
                                   FontSize="22"
                                   Margin="15,0,0,0"
                                   VerticalAlignment="Center"
                                   IsHitTestVisible="False"/>

                    </Grid>

                    <StackPanel Grid.Column="1"
                                Orientation="Horizontal"
                                Margin="14,0,0,0">

                        <Button x:Name="BtnPresetBasic"
                                Content="Básico"
                                Tag="Basico"
                                Style="{StaticResource ModernButton}"
                                Click="BtnPreset_Click"/>

                        <Button x:Name="BtnPresetOffice"
                                Content="Oficina"
                                Tag="Oficina"
                                Style="{StaticResource ModernButton}"
                                Margin="7,0,0,0"
                                Click="BtnPreset_Click"/>

                        <Button x:Name="BtnPresetGaming"
                                Content="Gaming"
                                Tag="Gaming"
                                Style="{StaticResource ModernButton}"
                                Margin="7,0,0,0"
                                Click="BtnPreset_Click"/>

                    </StackPanel>

                </Grid>

                <!-- CATEGORIES -->

                <Grid Grid.Row="1"
                      Margin="0,18,0,15">

                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Text="Categorías"
                               Foreground="{DynamicResource TextPrimary}"
                               FontSize="14"
                               FontWeight="Bold"/>

                    <ScrollViewer Grid.Row="1"
                                  HorizontalScrollBarVisibility="Auto"
                                  VerticalScrollBarVisibility="Disabled"
                                  Margin="0,10,0,0">

                        <StackPanel x:Name="CategoryPanel"
                                    Orientation="Horizontal"/>

                    </ScrollViewer>

                </Grid>

                <!-- APPLICATIONS -->

                <ScrollViewer Grid.Row="2"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">

                    <ItemsControl x:Name="AppsControl">

                        <ItemsControl.GroupStyle>

                            <GroupStyle>

                                <GroupStyle.HeaderTemplate>

                                    <DataTemplate>

                                        <TextBlock Text="{Binding Name}"
                                                   Foreground="{DynamicResource TextPrimary}"
                                                   FontSize="15"
                                                   FontWeight="Bold"
                                                   Margin="0,10,0,12"/>

                                    </DataTemplate>

                                </GroupStyle.HeaderTemplate>

                            </GroupStyle>

                        </ItemsControl.GroupStyle>

                        <ItemsControl.ItemsPanel>

                            <ItemsPanelTemplate>
                                <WrapPanel/>
                            </ItemsPanelTemplate>

                        </ItemsControl.ItemsPanel>

                        <ItemsControl.ItemTemplate>

                            <DataTemplate>

                                <Border Style="{StaticResource AppCard}"
                                        Width="320"
                                        MinHeight="138">

                                    <Grid>

                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="*"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>

                                        <Grid>

                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <Border Width="48"
                                                    Height="48"
                                                    CornerRadius="10"
                                                    Background="{DynamicResource BgItem}">

                                                <Image Source="{Binding Icon}"
                                                       Width="30"
                                                       Height="30"
                                                       Stretch="Uniform"/>

                                            </Border>

                                            <StackPanel Grid.Column="1"
                                                        Margin="12,0,8,0">

                                                <TextBlock Text="{Binding Name}"
                                                           Foreground="{DynamicResource TextPrimary}"
                                                           FontSize="14"
                                                           FontWeight="Bold"
                                                           TextTrimming="CharacterEllipsis"/>

                                                <TextBlock Text="{Binding Category}"
                                                           Foreground="{DynamicResource TextMuted}"
                                                           FontSize="10"
                                                           Margin="0,3,0,0"/>

                                            </StackPanel>

                                            <CheckBox Grid.Column="2"
                                                      IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                                      Style="{StaticResource ModernCheckBox}"
                                                      VerticalAlignment="Top"/>

                                        </Grid>

                                        <TextBlock Grid.Row="1"
                                                   Text="{Binding Description}"
                                                   Foreground="{DynamicResource TextSecondary}"
                                                   FontSize="11.5"
                                                   TextWrapping="Wrap"
                                                   Margin="0,13,0,8"/>

                                        <Grid Grid.Row="2">

                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <Border Background="{DynamicResource BgItem}"
                                                    CornerRadius="5"
                                                    Padding="7,3"
                                                    HorizontalAlignment="Left">

                                                <TextBlock Text="{Binding Preset}"
                                                           Foreground="{DynamicResource TextSecondary}"
                                                           FontSize="9"
                                                           FontWeight="SemiBold"/>

                                            </Border>

                                            <TextBlock Grid.Column="1"
                                                       Text="WinGet"
                                                       Foreground="{DynamicResource TextMuted}"
                                                       FontSize="9"
                                                       VerticalAlignment="Center"/>

                                        </Grid>

                                    </Grid>

                                </Border>

                            </DataTemplate>

                        </ItemsControl.ItemTemplate>

                    </ItemsControl>

                </ScrollViewer>

            </Grid>

            <!-- INSTALLATION BAR -->

            <Border Grid.Row="3"
                    Background="{DynamicResource BgCard}"
                    BorderBrush="{DynamicResource BorderColor}"
                    BorderThickness="1"
                    CornerRadius="10"
                    Padding="16"
                    Margin="0,18,0,0"
                    Effect="{StaticResource CardShadow}">

                <Grid>

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="230"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0"
                                VerticalAlignment="Center">

                        <StackPanel Orientation="Horizontal">

                            <Ellipse Width="8"
                                     Height="8"
                                     Fill="{DynamicResource Accent}"
                                     VerticalAlignment="Center"/>

                            <TextBlock x:Name="TxtStatus"
                                       Text="0 aplicaciones seleccionadas"
                                       Foreground="{DynamicResource TextPrimary}"
                                       FontSize="12"
                                       FontWeight="SemiBold"
                                       Margin="8,0,0,0"/>

                        </StackPanel>

                        <TextBlock Text="Selecciona las aplicaciones que quieres instalar."
                                   Foreground="{DynamicResource TextMuted}"
                                   FontSize="10"
                                   Margin="16,4,0,0"/>

                    </StackPanel>

                    <StackPanel Grid.Column="1"
                                VerticalAlignment="Center"
                                Margin="20,0">

                        <Grid>

                            <TextBlock Text="PROGRESO"
                                       Foreground="{DynamicResource TextMuted}"
                                       FontSize="9"
                                       FontWeight="Bold"/>

                            <TextBlock x:Name="TxtProgress"
                                       Text="0%"
                                       Foreground="{DynamicResource TextSecondary}"
                                       FontSize="9"
                                       HorizontalAlignment="Right"/>

                        </Grid>

                        <ProgressBar x:Name="ProgressInstall"
                                     Height="6"
                                     Minimum="0"
                                     Maximum="100"
                                     Value="0"
                                     Margin="0,7,0,0"/>

                    </StackPanel>

                    <StackPanel Grid.Column="2"
                                Orientation="Horizontal"
                                VerticalAlignment="Center"
                                Margin="0,0,15,0">

                        <CheckBox x:Name="ChkRestart"
                                  VerticalAlignment="Center"
                                  Cursor="Hand"/>

                        <TextBlock Text="Reiniciar"
                                   Foreground="{DynamicResource TextSecondary}"
                                   FontSize="10"
                                   VerticalAlignment="Center"
                                   Margin="5,0,12,0"/>

                        <CheckBox x:Name="ChkShutdown"
                                  VerticalAlignment="Center"
                                  Cursor="Hand"/>

                        <TextBlock Text="Apagar"
                                   Foreground="{DynamicResource TextSecondary}"
                                   FontSize="10"
                                   VerticalAlignment="Center"
                                   Margin="5,0,0,0"/>

                    </StackPanel>

                    <Button x:Name="BtnCancel"
                            Grid.Column="3"
                            Content="Cancelar"
                            Style="{StaticResource ModernButton}"
                            Margin="0,0,8,0"
                            Click="BtnCancel_Click"/>

                    <Button x:Name="BtnStart"
                            Grid.Column="4"
                            Content="Instalar aplicaciones  →"
                            Style="{StaticResource PrimaryButton}"
                            Click="BtnStart_Click"/>

                </Grid>

            </Border>

        </Grid>

        <!-- CONSOLE -->

        <Border x:Name="ConsolePanel"
                Grid.Column="1"
                Background="{DynamicResource ConsoleBg}"
                CornerRadius="10"
                Margin="50"
                Visibility="Collapsed">

            <Grid Margin="18">

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Grid>

                    <TextBlock Text="INSTALACIÓN"
                               Foreground="{DynamicResource ConsoleText}"
                               FontSize="11"
                               FontWeight="Bold"/>

                    <Button x:Name="BtnCloseConsole"
                            Content="×"
                            Foreground="{DynamicResource ConsoleText}"
                            Background="Transparent"
                            BorderThickness="0"
                            FontSize="20"
                            HorizontalAlignment="Right"
                            Click="BtnCloseConsole_Click"/>

                </Grid>

                <ScrollViewer Grid.Row="1"
                              Margin="0,14,0,0">

                    <TextBox x:Name="TxtLog"
                             Background="Transparent"
                             Foreground="{DynamicResource ConsoleText}"
                             BorderThickness="0"
                             FontFamily="Consolas"
                             FontSize="11"
                             IsReadOnly="True"
                             TextWrapping="Wrap"
                             VerticalScrollBarVisibility="Auto"/>

                </ScrollViewer>

            </Grid>

        </Border>

    </Grid>

</Window>